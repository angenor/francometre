# Dépendances
node_modules/

# Sorties de compilation Nuxt / Nitro
.nuxt/
.output/
.data/
dist/
build/

# Cache d'outillage
.nitro/
.cache/
.vite/

# Prisma — le client généré ne rentre jamais dans Git (research.md D2),
# la base locale non plus.
prisma/generated/
prisma/*.db
prisma/*.db-journal

# Médias sur disque — contenu généré (seed) ou téléversé, jamais versionné
# (même statut que la base locale). Le stockage est réhydraté par le seed.
stockage/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Environnement
.env
.env.*
!.env.example

# Journaux
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Système et éditeurs
.DS_Store
Thumbs.db
*.tmp
*.swp
.vscode/
.idea/
