# Base de données — fichier SQLite local, aucun service externe.
DATABASE_URL="file:./prisma/dev.db"

# Implémentation de stockage des médias : `disque` est la seule livrée.
# `s3` est anticipée par l'interface, mais rien ne l'implémente encore
# (contracts/stockage.md §3).
STOCKAGE="disque"

# Secret de scellement du cookie de session (nuxt-auth-utils) — chaîne aléatoire
# d'AU MOINS 32 caractères. Jamais commité ; générer par instance
# (p. ex. `openssl rand -base64 48`).
NUXT_SESSION_PASSWORD=""

# Amorçage du compte de rédaction par le seed (research D7). Présentes au SEED
# UNIQUEMENT : le serveur en fonctionnement ne porte aucun de ces secrets. Sans
# `COMPTE_REDACTION_MOT_DE_PASSE`, le seed SAUTE la création du compte (jamais de
# mot de passe par défaut). Le mot de passe d'amorçage vise ≥ 12 caractères.
COMPTE_REDACTION_IDENTIFIANT="redaction@francometre.com"
COMPTE_REDACTION_NOM="Rédaction"
COMPTE_REDACTION_MOT_DE_PASSE=""
