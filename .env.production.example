# Francomètre — variables d'exécution en production.
# Le vrai fichier `.env` est GÉNÉRÉ sur le serveur par `deploy.sh setup`
# (secrets aléatoires). Ce modèle documente les clés attendues.

# --- Base de données -------------------------------------------------------
# Fichier SQLite sur un volume persistant. Chemin ABSOLU (le conteneur tourne
# depuis /app, mais la base vit hors de l'arbre applicatif, sur /data).
DATABASE_URL="file:/data/db/francometre.db"

# --- Stockage des médias ---------------------------------------------------
# Seule implémentation livrée. Les fichiers vont sous /app/stockage/medias,
# monté sur un volume persistant.
STOCKAGE="disque"

# --- Session (nuxt-auth-utils) ---------------------------------------------
# Secret de scellement du cookie, AU MOINS 32 caractères, unique par instance.
# Généré par `openssl rand -base64 48`. Jamais commité.
NUXT_SESSION_PASSWORD=""

# --- URL publique ----------------------------------------------------------
# Sert à composer les URL absolues (RSS, sitemap, Open Graph). Jamais dérivée
# de l'en-tête Host.
NUXT_PUBLIC_SITE_URL="https://francometre.com"

# --- Amorçage (seed) — lu UNIQUEMENT quand FRANCOMETRE_SEED=1 ---------------
# Le serveur en fonctionnement ne porte aucun de ces secrets. Sans mot de passe,
# le seed saute la création du compte (jamais de mot de passe par défaut).
COMPTE_REDACTION_IDENTIFIANT="redaction@francometre.com"
COMPTE_REDACTION_NOM="Rédaction"
COMPTE_REDACTION_MOT_DE_PASSE=""

# Déclencheur d'amorçage. Laisser à 0 en régime courant ; `deploy.sh seed` le
# passe à 1 le temps d'un lancement ponctuel.
FRANCOMETRE_SEED="0"
